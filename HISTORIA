<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HistoriGrafia - Meus Estudos</title>
    <!-- Tailwind CSS para um design moderno e responsivo -->
    <script src="https://jsdelivr.net"></script>
    <style>
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #888; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #555; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen">

    <!-- Barra de Navegação -->
    <nav class="bg-indigo-900 text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <span class="text-2xl">📜</span>
                <h1 class="text-xl font-bold tracking-wide">HistoriGrafia</h1>
            </div>
            <p class="text-sm text-indigo-200 hidden sm:block">Meu Banco de Dados Históricos Pessoal</p>
        </div>
    </nav>

    <!-- Conteúdo Principal -->
    <main class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Coluna Esquerda: Linha do Tempo (Fixa) -->
        <section class="lg:col-span-1 bg-white p-6 rounded-xl shadow-xs border border-slate-100">
            <h2 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                ⏳ Linha do Tempo das Eras
            </h2>
            
            <div class="relative border-l border-indigo-200 ml-3 space-y-6">
                <div class="mb-4 ml-6">
                    <span class="absolute flex items-center justify-center w-6 h-6 bg-indigo-100 text-indigo-800 rounded-full -left-3 ring-4 ring-white text-xs font-bold">1</span>
                    <h3 class="font-semibold text-slate-800">Pré-História</h3>
                    <p class="text-xs text-slate-500">Até c. 4000 a.C. (Invenção da escrita)</p>
                </div>
                <div class="mb-4 ml-6">
                    <span class="absolute flex items-center justify-center w-6 h-6 bg-indigo-100 text-indigo-800 rounded-full -left-3 ring-4 ring-white text-xs font-bold">2</span>
                    <h3 class="font-semibold text-slate-800">Idade Antiga</h3>
                    <p class="text-xs text-slate-500">4000 a.C. a 476 d.C. (Queda de Roma)</p>
                </div>
                <div class="mb-4 ml-6">
                    <span class="absolute flex items-center justify-center w-6 h-6 bg-indigo-100 text-indigo-800 rounded-full -left-3 ring-4 ring-white text-xs font-bold">3</span>
                    <h3 class="font-semibold text-slate-800">Idade Média</h3>
                    <p class="text-xs text-slate-500">476 d.C. a 1453 (Queda de Constantinopla)</p>
                </div>
                <div class="mb-4 ml-6">
                    <span class="absolute flex items-center justify-center w-6 h-6 bg-indigo-100 text-indigo-800 rounded-full -left-3 ring-4 ring-white text-xs font-bold">4</span>
                    <h3 class="font-semibold text-slate-800">Idade Moderna</h3>
                    <p class="text-xs text-slate-500">1453 a 1789 (Revolução Francesa)</p>
                </div>
                <div class="ml-6">
                    <span class="absolute flex items-center justify-center w-6 h-6 bg-indigo-500 text-white rounded-full -left-3 ring-4 ring-white text-xs font-bold">5</span>
                    <h3 class="font-semibold text-slate-800">Idade Contemporânea</h3>
                    <p class="text-xs text-slate-500">1789 até a atualidade</p>
                </div>
            </div>
        </section>

        <!-- Coluna Direita: Catálogo Dinâmico -->
        <section class="lg:col-span-2 space-y-6">
            <div class="bg-white p-4 rounded-xl shadow-xs border border-slate-100 flex flex-col sm:flex-row gap-4 justify-between items-center">
                <div class="relative w-full sm:w-72">
                    <input type="text" id="searchInput" oninput="filterCharacters()" placeholder="Buscar personagem ou era..." 
                        class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2 text-sm focus:outline-hidden focus:ring-2 focus:ring-indigo-500">
                </div>
                <button onclick="toggleModal(true)" class="w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors cursor-pointer shadow-xs">
                    + Adicionar Personagem
                </button>
            </div>

            <div id="charactersGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Inserido dinamicamente via JavaScript -->
            </div>
        </section>
    </main>

    <!-- Modal Formulário -->
    <div id="modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs hidden justify-center items-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md overflow-hidden">
            <div class="bg-indigo-900 text-white p-4 flex justify-between items-center">
                <h3 class="font-bold text-lg">Novo Registro Histórico</h3>
                <button onclick="toggleModal(false)" class="text-white/70 hover:text-white text-xl cursor-pointer">&times;</button>
            </div>
            
            <form id="charForm" onsubmit="saveCharacter(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Nome completo</label>
                    <input type="text" id="name" required placeholder="Ex: Cleópatra" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-hidden">
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Nascimento</label>
                        <input type="text" id="birth" required placeholder="Ex: 69 a.C." class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-hidden">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Falecimento</label>
                        <input type="text" id="death" required placeholder="Ex: 30 a.C." class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-hidden">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Era Histórica</label>
                    <select id="era" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-hidden">
                        <option value="Pré-História">Pré-História</option>
                        <option value="Idade Antiga" selected>Idade Antiga</option>
                        <option value="Idade Média">Idade Média</option>
                        <option value="Idade Moderna">Idade Moderna</option>
                        <option value="Idade Contemporânea">Idade Contemporânea</option>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Religião</label>
                        <input type="text" id="religion" placeholder="Ex: Religião Egípcia" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-hidden">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Idioma Oficial</label>
                        <input type="text" id="language" placeholder="Ex: Egípcio antigo" class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-hidden">
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" onclick="toggleModal(false)" class="px-4 py-2 border border-slate-200 rounded-lg text-slate-600 text-sm hover:bg-slate-50 cursor-pointer">Cancelar</button>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-semibold shadow-xs cursor-pointer">Salvar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript Lógico do Sistema -->
    <script>
        let characters = [];

        window.addEventListener('DOMContentLoaded', () => {
            const saved = localStorage.getItem('historografia_db');
            if (saved) {
                characters = JSON.parse(saved);
            } else {
                characters = [
                    { id: 1, name: 'Leonardo da Vinci', birth: '1452', death: '1519', era: 'Idade Moderna', religion: 'Catolicismo', language: 'Italiano' },
                    { id: 2, name: 'Júlio César', birth: '100 a.C.', death: '44 a.C.', era: 'Idade Antiga', religion: 'Politeísmo Romano', language: 'Latim' }
                ];
                saveToLocalStorage();
            }
            renderCharacters(characters);
        });

        function saveToLocalStorage() {
            localStorage.setItem('historografia_db', JSON.stringify(characters));
        }

        function toggleModal(show) {
