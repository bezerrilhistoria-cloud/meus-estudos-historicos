    script
         Array que vai guardar os personagens na memória do navegador
        let characters = [];

         Carregar dados salvos no navegador ao abrir a página
        window.onload = function() {
            const savedChars = localStorage.getItem('historical_characters');
            if (savedChars) {
                characters = JSON.parse(savedChars);
                renderCharacters();
            }
        };

         Funções para abrirfechar o formulário
        function openModal() {
            document.getElementById('charModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('charModal').style.display = 'none';
            document.getElementById('charForm').reset();
        }

